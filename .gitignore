# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user-uploaded files (live copy lives on the server)
/storage/
!.env.example

# Leftovers from the Laravel site (local only)
/vendor
/error_log
/.phpunit.result.cache
/bootstrap
/config
/app
/api
/database/*
!/database/quadrant.sqlite
/resources
/routes
/tests
