{
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "echo skip",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{public/**,node_modules/**,.git/**,tests/**,storage/logs/**}"
    }
  },
  "routes": [
    {
      "src": "/public/(.*\\.(?:jpg|jpeg|png|webp|avif|gif|svg|ico|jfif|mp4|webm|woff2?|ttf|otf|eot|pdf))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/public/(.*\\.(?:css|js|map))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/public/(.*)",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/laravel/config.php",
    "APP_EVENTS_CACHE": "/tmp/laravel/events.php",
    "APP_PACKAGES_CACHE": "/tmp/laravel/packages.php",
    "APP_ROUTES_CACHE": "/tmp/laravel/routes.php",
    "APP_SERVICES_CACHE": "/tmp/laravel/services.php",
    "VIEW_COMPILED_PATH": "/tmp/laravel/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie"
  }
}