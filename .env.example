# Public URL of the site (used in emails, sitemap, canonical links)
SITE_URL=http://localhost:3000

# MySQL — the same database the Laravel site uses
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quadrant
DB_USERNAME=root
DB_PASSWORD=

# Long random string used to sign the admin login cookie and form timestamps
SESSION_SECRET=

# Where uploaded files (uploads/...) are stored on disk
UPLOAD_DIR=./storage/uploads

# Outgoing mail for inquiry notifications
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Quadrant Properties
INQUIRY_NOTIFY_EMAILS=quadrantpropertiesai@gmail.com

# Sanity (blog posts)
SANITY_PROJECT_ID=60y5olnp
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
